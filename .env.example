# Copy to .env and fill in. .env is gitignored; never commit or paste it anywhere.
# Keep this file OUT of a synced folder (OneDrive, Dropbox, iCloud) if you can.

# --- ESPN (cookies from your logged in browser; see ESPN-MCP.md) ---
# WARNING: these two cookies are full access to your ESPN account, not just fantasy.
ESPN_S2=
ESPN_SWID=
ESPN_SPORT=ffl
ESPN_SEASON=
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=

# --- Yahoo (see YAHOO-SETUP.md) ---
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
YAHOO_LEAGUE_KEY=
YAHOO_SPORT=
YAHOO_SEASON=

# --- Sleeper needs nothing for reads ---

# --- Optional second opinion reviewers (see KEYS.md) ---
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
